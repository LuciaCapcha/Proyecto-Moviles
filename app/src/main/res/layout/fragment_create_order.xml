<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generar Orden de Compra"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Par de monedas:"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />
        <Spinner
            android:id="@+id/spinner_currency_pair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp" />
        <TextView
            android:id="@+id/tv_highest_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Precio más alto: S/. 0.00"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="15dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cantidad:"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />
        <EditText
            android:id="@+id/et_quantity"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Ingresa la cantidad"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:layout_marginBottom="15dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Precio unitario:"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />
        <EditText
            android:id="@+id/et_unit_price"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Precio unitario"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:layout_marginBottom="15dp" />
        <TextView
            android:id="@+id/tv_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total: S/. 0.00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#2196F3"
            android:layout_marginBottom="20dp"
            android:padding="15dp"
            android:background="#E8F5E9"
            android:gravity="center" />
        <TextView
            android:id="@+id/tv_validation_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:layout_marginBottom="15dp"
            android:padding="10dp"
            android:gravity="center" />
        <Button
            android:id="@+id/btn_confirm_order"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Confirmar Orden"
            android:textSize="16sp"
            android:textStyle="bold"
            android:enabled="false"
            android:backgroundTint="@color/design_default_color_primary"
            android:textColor="@android:color/white" />
    </LinearLayout>
</ScrollView>